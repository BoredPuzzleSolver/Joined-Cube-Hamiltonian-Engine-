+def coupling_channels(a,b,c,d):
+    """Doubled k values common to a⊗b and c⊗d; no extra truncation."""
+    if (a+b-c-d)%2:return ()
+    low=max(abs(a-b),abs(c-d));high=min(a+b,c+d)
+    if (low-a-b)%2:low+=1
+    return tuple(range(low,high+1,2))
