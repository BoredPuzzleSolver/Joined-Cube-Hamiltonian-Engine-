+@dataclass(frozen=True)
+class SpectrumResult:
+    """Numerical Ritz spectrum in a specified finite basis, not a certificate."""
+
+    e0: float
+    e1: float
+    gap: float
+    eigenvalues: tuple
+    residual_norms: tuple
+    converged: bool
+    dimension: int
+    num_cubes: int
